#. Plugin Name of the plugin
#: micro-site-care-post-last-updated-date.php
msgid "MSC: Post Last Updated Date"
msgstr "MSC: Data dell'ultimo aggiornamento dell'articolo"

#. Plugin URI of the plugin
#: micro-site-care-post-last-updated-date.php
msgid "https://github.com/djm56/msc-last-updated"
msgstr "https://github.com/djm56/msc-last-updated"

#. Description of the plugin
#: micro-site-care-post-last-updated-date.php
msgid "Display and control the post last-updated date in flexible positions."
msgstr ""
"Visualizza e controlla la data dell'ultimo aggiornamento dei post in "
"posizioni flessibili."

#. Author of the plugin
#: micro-site-care-post-last-updated-date.php
msgid "Anomalous Developers"
msgstr "Anomalous Developers"

#. Author URI of the plugin
#: micro-site-care-post-last-updated-date.php
msgid "https://anomalous.co.za"
msgstr "https://anomalous.co.za"

#. translators: %s is a human-readable time difference, e.g. "3 days".
#: includes/class-micro-site-care-post-last-updated-date-module.php:122
#, php-format
msgid "%s ago"
msgstr "%s fa"

#. translators: %s is the formatted post last-updated date.
#: includes/class-micro-site-care-post-last-updated-date-module.php:133
#: includes/class-micro-site-care-post-last-updated-date-settings.php:101
