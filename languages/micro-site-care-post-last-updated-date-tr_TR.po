#. code
#: includes/class-micro-site-care-post-last-updated-date-settings.php:259
#, php-format
msgid ""
"Use %1$s where the date should appear, e.g. %2$s. Omit %1$s to show the "
"label with no date."
msgstr ""
"Tarihin görünmesi gereken yerde %1$s kullanın, örn. %2$s. Etiketi tarihsiz "
"göstermek için %1$s'i çıkarın."

